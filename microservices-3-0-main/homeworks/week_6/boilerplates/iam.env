# PostgreSQL
POSTGRES_DB=iam-service
POSTGRES_USER=iam-service-user
POSTGRES_PASSWORD=iam-service-password
POSTGRES_PORT=5434

DB_URI=postgres://iam-service-user:iam-service-password@localhost:5434/iam-service?sslmode=disable
MIGRATIONS_DIR=migrations/iam

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Сессии
SESSION_TTL=24h

# Версии Docker-образов
POSTGRES_IMAGE=postgres:18.3-alpine3.23
REDIS_IMAGE=redis:8.6.3-alpine3.23
