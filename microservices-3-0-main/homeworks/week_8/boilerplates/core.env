# ----------------------------
# Kafka (core-инфраструктура)
# ----------------------------
# Используется в docker-compose для Kafka и Kafka UI.
# Подключается через --env-file core.env в Taskfile.

# Порты
KAFKA_EXTERNAL_PORT=9092
KAFKA_INTERNAL_PORT=29092
KAFKA_CONTROLLER_PORT=29093
KAFKA_UI_PORT=8090

# Версии Docker-образов
KAFKA_IMAGE=confluentinc/cp-kafka:8.2.0
KAFKA_UI_IMAGE=ghcr.io/kafbat/kafka-ui:v1.5.0

# ----------------------------
# Observability
# ----------------------------
# Используется в docker-compose для observability-инфраструктуры.

# Версии Docker-образов
JAEGER_IMAGE=jaegertracing/jaeger:2.17.0
PROMETHEUS_IMAGE=prom/prometheus:v3.11.3
GRAFANA_IMAGE=grafana/grafana:13.0.1
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:9.4.0
KIBANA_IMAGE=docker.elastic.co/kibana/kibana:9.4.0
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.151.0

# Порты
JAEGER_UI_PORT=16686
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601
OTEL_GRPC_PORT=4317
OTEL_METRICS_PORT=8888

# ----------------------------
# Контейнеризация
# ----------------------------
# Используется в docker-compose для сервисов, Nginx и Redis rate limiter.

# Порт, на котором Nginx (load balancer перед OrderService) принимает HTTP-трафик на хосте.
HTTP_PORT=8080

# Порт Redis rate limiter (для подключения с хоста через localhost)
REDIS_RATELIMIT_PORT=6379

# Версии Docker-образов
NGINX_IMAGE=nginx:1.30.0-alpine3.23
REDIS_RATELIMIT_IMAGE=redis:8.6.1-alpine3.23

# ----------------------------
# Сборка приложений (build args для Dockerfile'ов)
# ----------------------------
# Подключаются в build.args в docker-compose'ах (services, iam, inventory, order)
# и подхватываются Taskfile через dotenv. Менять версии — здесь, в одном месте.
GO_IMAGE=golang:1.26-alpine3.23
ALPINE_IMAGE=alpine:3.23
GOOSE_VERSION=v3.27.1
