GRPC_HOST=localhost
GRPC_PORT=50051

LOGGER_LEVEL=info

POSTGRES_DB=ufo
POSTGRES_USER=ufo_admin
POSTGRES_PASSWORD=ufo_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_SSLMODE=disable
DB_URI=postgres://ufo_admin:ufo_secret@localhost:5433/ufo
MIGRATIONS_DIR=ufo/migrations

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CONNECTION_TIMEOUT=10s
REDIS_MAX_IDLE=10
REDIS_IDLE_TIMEOUT=10s
REDIS_CACHE_TTL=1h

# Версии Docker-образов
POSTGRES_IMAGE=postgres:18.3-alpine3.23
REDIS_IMAGE=redis:8.6.3-alpine3.23
