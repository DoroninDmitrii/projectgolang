  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "gRPC RPS — OK vs Failed (вид со стороны сервера)",
      "description": "RPS, который видит сервер: OK и INTERNAL приходят из otelgrpc StatsHandler. Отказы circuit breaker'а здесь невидимы — CB режет запрос на стороне клиента, до сети, и серверу его не присылает. Поэтому в момент CB Open ожидаем просадку всех серий до нуля: для сервера это выглядит как «трафик пропал».",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0},
      "targets": [
        {"expr": "sum(rate(rpc_server_call_duration_seconds_count{rpc_response_status_code=\"OK\"}[1m])) or vector(0)", "legendFormat": "OK"},
        {"expr": "sum(rate(rpc_server_call_duration_seconds_count{rpc_response_status_code=\"INTERNAL\"}[1m])) or vector(0)", "legendFormat": "Internal (server failure)"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "reqps", "min": 0},
        "overrides": [
          {"matcher": {"id": "byName", "options": "OK"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]},
          {"matcher": {"id": "byName", "options": "Internal (server failure)"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]}
        ]
      }
    },
    {
      "title": "gRPC Error Rate, % (со стороны сервера)",
      "description": "Доля не-OK ответов сервера. Считается только по запросам, которые до сервера дошли — отказы CB на клиенте сюда не попадают по той же причине, что и на графике RPS.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {"expr": "100 * sum(rate(rpc_server_call_duration_seconds_count{rpc_response_status_code!=\"OK\"}[1m])) / sum(rate(rpc_server_call_duration_seconds_count[1m])) or vector(0)", "legendFormat": "Error Rate %"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "percent", "min": 0, "max": 100},
        "overrides": [
          {"matcher": {"id": "byName", "options": "Error Rate %"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}
        ]
      }
    },
    {
      "title": "gRPC Latency p50 / p95 / p99 (со стороны сервера)",
      "description": "Перцентили длительности обработки на сервере. Считаются по rpc_server_call_duration_seconds_bucket, который пишет otelgrpc StatsHandler. Только реально обработанные запросы; отказы CB сюда не входят (их сервер не видит).",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(rpc_server_call_duration_seconds_bucket[1m])) by (le))", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.95, sum(rate(rpc_server_call_duration_seconds_bucket[1m])) by (le))", "legendFormat": "p95"},
        {"expr": "histogram_quantile(0.99, sum(rate(rpc_server_call_duration_seconds_bucket[1m])) by (le))", "legendFormat": "p99"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "s", "min": 0},
        "overrides": [
          {"matcher": {"id": "byName", "options": "p50"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]},
          {"matcher": {"id": "byName", "options": "p95"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "yellow"}}]},
          {"matcher": {"id": "byName", "options": "p99"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}
        ]
      }
    }
  ],
