GRPC_HOST=localhost
GRPC_PORT=50051

LOGGER_LEVEL=info
LOGGER_AS_JSON=true

POSTGRES_DB=ufo
POSTGRES_USER=ufo_admin
POSTGRES_PASSWORD=ufo_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_SSLMODE=disable
DB_URI=postgres://ufo_admin:ufo_secret@localhost:5433/ufo
MIGRATIONS_DIR=ufo/migrations

KAFKA_BROKERS=localhost:9092
KAFKA_EXTERNAL_PORT=9092
KAFKA_INTERNAL_PORT=29092
KAFKA_CONTROLLER_PORT=29093
KAFKA_UI_PORT=8090
UFO_RECORDED_TOPIC_NAME=ufo.recorded
UFO_RECORDED_CONSUMER_GROUP_ID=2

# Версии Docker-образов
POSTGRES_IMAGE=postgres:18.3-alpine3.23
KAFKA_IMAGE=confluentinc/cp-kafka:8.2.0
KAFKA_UI_IMAGE=ghcr.io/kafbat/kafka-ui:v1.5.0
