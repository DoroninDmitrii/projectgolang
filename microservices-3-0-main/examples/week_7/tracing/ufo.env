GRPC_HOST=localhost
GRPC_PORT=50051

LOGGER_LEVEL=info

POSTGRES_DB=ufo
POSTGRES_USER=ufo_admin
POSTGRES_PASSWORD=ufo_secret
POSTGRES_PORT=5433

PG_HOST=localhost
PG_SSLMODE=disable

OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=ufo-service
OTEL_ENVIRONMENT=development
OTEL_SERVICE_VERSION=1.0.0

DB_URI=postgres://ufo_admin:ufo_secret@localhost:5433/ufo
MIGRATIONS_DIR=ufo/migrations

# Версии Docker-образов
POSTGRES_IMAGE=postgres:18.3-alpine3.23
